{
  "name": "karrio-qa-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-augmented QA demo: Playwright + TypeScript tests for the Karrio shipping platform",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui-desktop --project=ui-mobile",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=ui-desktop --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "20.16.11",
    "dotenv": "16.4.5",
    "typescript": "5.6.3"
  }
}
